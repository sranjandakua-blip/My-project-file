 "lines": [
  {
   "i": 0,
   "text": "Photos looking hazy and soft?",
   "start": 0.35,
   "end": 1.936
  },
  {
   "i": 1,
   "text": "Lesson three: clean your lens.",
   "start": 2.156,
   "end": 3.772
  },
  {
   "i": 2,
   "text": "Your fingers touch it all day, and leave grease behind,",
   "start": 3.992,
   "end": 6.802
  },
  {
   "i": 3,
   "text": "and pockets and bags add dust and lint.",
   "start": 7.162,
   "end": 9.322
  },
  {
   "i": 4,
   "text": "That film makes lights glow and details blur.",
   "start": 9.542,
   "end": 11.965
  },
  {
   "i": 5,
   "text": "Wipe it gently with a soft microfiber cloth,",
   "start": 12.185,
   "end": 14.845
  },
  {
   "i": 6,
   "text": "not your shirt, which can rub grit into the glass.",
   "start": 15.305,
   "end": 17.856
  },
  {
   "i": 7,
   "text": "Make it a habit: one quick wipe before every shot.",
   "start": 18.076,
   "end": 20.835
  },
  {
   "i": 8,
   "text": "Crisp and clear.",
   "start": 21.055,
   "end": 21.914
  },
  {
   "i": 9,
   "text": "Follow for lesson four!",
   "start": 22.134,
   "end": 23.405
  }
 ]
}