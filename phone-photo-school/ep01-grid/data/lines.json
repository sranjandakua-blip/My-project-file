 "lines": [
  {
   "i": 0,
   "text": "Want better photos from your phone?",
   "start": 0.35,
   "end": 1.964
  },
  {
   "i": 1,
   "text": "Lesson one: the grid.",
   "start": 2.184,
   "end": 3.453
  },
  {
   "i": 2,
   "text": "Open camera settings, and turn on grid lines.",
   "start": 3.673,
   "end": 6.188
  },
  {
   "i": 3,
   "text": "Two lines across, two lines down, splitting your frame into thirds.",
   "start": 6.408,
   "end": 10.162
  },
  {
   "i": 4,
   "text": "Now put your subject where the lines cross,",
   "start": 10.382,
   "end": 12.382
  },
  {
   "i": 5,
   "text": "not dead center.",
   "start": 12.632,
   "end": 13.524
  },
  {
   "i": 6,
   "text": "Keep your horizon on a line too, never through the middle.",
   "start": 13.744,
   "end": 16.452
  },
  {
   "i": 7,
   "text": "Your shot instantly feels balanced.",
   "start": 16.672,
   "end": 18.442
  },
  {
   "i": 8,
   "text": "Try it on your next walk, and tag me!",
   "start": 18.662,
   "end": 20.608
  },
  {
   "i": 9,
   "text": "Follow for lesson two!",
   "start": 20.828,
   "end": 22.032
  }
 ]
}